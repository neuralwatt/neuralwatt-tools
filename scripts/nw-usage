#!/bin/bash
# Neuralwatt API usage - shows today's request count and energy consumption
#
# Usage:
#   nw-usage                       # Human-readable output (always fresh)
#   nw-usage --tmux                # Compact for tmux/statusline (cached 1 min)
#   nw-usage --tmux --color '1;32' # With ANSI color (bright green)
#   nw-usage --json                # Raw JSON (always fresh)

set -euo pipefail

CACHE_FILE="${NW_USAGE_CACHE_FILE:-/tmp/nw-usage-cache.json}"
CACHE_MAX_AGE=60  # seconds
API_KEY_FILE="${NEURALWATT_API_KEY_FILE:-$HOME/.config/neuralwatt/api_key}"

# Parse args
FORMAT="human"
USE_CACHE=false
COLOR=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --tmux) FORMAT="tmux"; USE_CACHE=true; shift ;;
    --json) FORMAT="json"; shift ;;
    --color)
      COLOR="${2:-}"
      shift 2
      ;;
    --help|-h)
      echo "Usage: nw-usage [--tmux|--json] [--color CODE]"
      echo "  --tmux        Compact output for statusline (cached)"
      echo "  --json        Raw JSON from API"
      echo "  --color CODE  ANSI color code (e.g., '1;32' for bright green)"
      exit 0
      ;;
    *) echo "Unknown option: $1"; exit 1 ;;
  esac
done

# Check cache freshness (only for --tmux)
use_cache=false
if [[ "$USE_CACHE" == "true" ]] && [[ -f "$CACHE_FILE" ]]; then
  if [[ "$(uname)" == "Darwin" ]]; then
    cache_mtime=$(stat -f %m "$CACHE_FILE")
  else
    cache_mtime=$(stat -c %Y "$CACHE_FILE")
  fi
  cache_age=$(($(date +%s) - cache_mtime))
  if [[ $cache_age -lt $CACHE_MAX_AGE ]]; then
    use_cache=true
  fi
fi

# Get data (from cache or API)
if [[ "$use_cache" == "true" ]]; then
  data=$(cat "$CACHE_FILE")
else
  # Get API key
  if [[ -n "${NEURALWATT_API_KEY:-}" ]]; then
    api_key="$NEURALWATT_API_KEY"
  elif [[ -f "$API_KEY_FILE" ]]; then
    api_key=$(cat "$API_KEY_FILE")
  else
    echo "Error: No API key found. Set NEURALWATT_API_KEY or create $API_KEY_FILE" >&2
    exit 1
  fi

  data=$(curl -s -H "Authorization: Bearer $api_key" \
    https://api.neuralwatt.com/v1/usage/energy 2>/dev/null)

  # A day with no requests has no row, so an empty daily list is valid.
  if [[ -z "$data" ]] || ! jq -e '.daily | type == "array"' >/dev/null 2>&1 <<< "$data"; then
    echo "Error: Failed to fetch usage data" >&2
    exit 1
  fi

  printf '%s\n' "$data" > "$CACHE_FILE"
fi

# The API groups usage by UTC day and lists only days with requests, so pick
# today's row by date and fall back to zeros before the first request of the day.
today=$(date -u +%Y-%m-%d)
today_row=$(jq -c --arg today "$today" \
  'first(.daily[] | select(.date == $today)) // {date: $today, requests: 0, energy_kwh: 0, energy_joules: 0}' \
  <<< "$data")

# Format output
case "$FORMAT" in
  json)
    printf '%s\n' "$data"
    ;;
  tmux)
    output=$(jq -r '"↗\(.requests) ⚡\(.energy_kwh * 1000 | round)Wh"' <<< "$today_row")
    if [[ -n "$COLOR" ]]; then
      printf "\033[%sm%s\033[0m\n" "$COLOR" "$output"
    else
      printf '%s\n' "$output"
    fi
    ;;
  human)
    jq -r '"Neuralwatt Usage for \(.date)\n  Requests: \(.requests)\n  Energy: \(.energy_kwh * 1000 | round)Wh (\(.energy_joules | round)J)"' <<< "$today_row"
    ;;
esac
